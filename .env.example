# 复制本文件为 .env 后再改。docker compose 会自动读取 .env。
# 把每一处 CHANGE_ME 换成只有你们自己知道的值。
# 不要把填好的 .env 提交到仓库，也不要发给无关的人。
# 仓库里没有真实密钥；下面的 CHANGE_ME 和文档里的 demo-* 都只是占位。

# 采集 / 写入用的密钥（只给导入脚本用，不要贴进浏览器）
TOKEN_RANKINGS_API_KEY=CHANGE_ME

# 公开站点 Google 登录。私有部署留空，登录页只用用户密钥。
# 客户端要在 Google Cloud 控制台自己创建。不要把填好的密钥提交到仓库。
# 回调地址必须与控制台逐字相同。公开站点：
#   https://tokenrank.online/auth/google/callback
# GOOGLE_CLIENT_ID=粘贴客户端 ID
# GOOGLE_CLIENT_SECRET=粘贴客户端密钥
# GOOGLE_REDIRECT_URI=https://tokenrank.online/auth/google/callback
# GOOGLE_ADMIN_EMAILS=管理员邮箱@example.com

# 生产环境必须改为 1：不登录就不能看排行。
# 本机第一次体验可以保持 0，页面会提示你还在用演示配置。
RANKINGS_REQUIRE_AUTH=0

# 启动时不要自动灌入演示人设（0 = 关）
SEED_ON_START=0

# 用户名单。试用默认是容器里的演示文件（demo-alice-key 等）：
USERS_FILE=/app/fixtures/users.json
# 交付时不要改 fixtures/users.json。用仓库外或 gitignore 的生产名单：
#   bash scripts/bootstrap_prod.sh
#   生成 fixtures/users.prod.json（只存 SHA-256；明文只打印一次）
# 然后在 docker-compose.yml 取消注释这一卷，把文件挂进容器（只读）：
#   - ./fixtures/users.prod.json:/run/token-rankings/users.json:ro
# 也可以挂仓库外的文件，形状见 fixtures/users.example.json：
#   - /secure/token-rankings/users.json:/run/token-rankings/users.json:ro
# 并把上面的 USERS_FILE 改成容器内路径：
# USERS_FILE=/run/token-rankings/users.json
# 也可以不使用文件，直接写在这里（整行取消注释并替换 CHANGE_ME）：
# USERS_JSON=[{"api_key":"CHANGE_ME","role":"member","account_id":"your-account","name":"你的名字"}]

# 数据库：不设置则使用 SQLite（适合第一次试用）。
# Postgres 见 docs/INSTALL.md。必须设置 POSTGRES_PASSWORD，不要用 token 当密码。
# 端口只绑定 127.0.0.1。用户名 token 只是角色名，不是密码。
# POSTGRES_USER=token
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=token_rankings
# DATABASE_URL=postgresql://token:CHANGE_ME@postgres:5432/token_rankings

# 下面都是可选项。没有就保持注释，不要填真实密钥再提交。
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_MASTER_KEY=CHANGE_ME
# CURSOR_ADMIN_API_KEY=CHANGE_ME
# WORKBUDDY_PROJECTS_DIR=/workbuddy/projects
# CLAUDE_PROJECTS_DIR=/claude/projects
# CLAUDE_ACCOUNT_ID=you@company.com
# CODEX_SESSIONS_DIR=/codex/sessions
# CODEX_ACCOUNT_ID=you@company.com
# CONTINUE_DATA_DIR=/continue/dev_data
# CONTINUE_ACCOUNT_ID=you@company.com

# 试点提醒。页面 /alerts，说明见 docs/INSTALL.md「企业试点上线清单」。
# 低用量 Token 阈值（默认 10000）。成员密钥只评估自己的账号。
# LOW_USAGE_THRESHOLD_TOKENS=10000
# 相对上一等长窗口的费用倍数（默认 2）。低于最小金额不报突增（默认 1 美元）。
# ALERT_SPEND_SPIKE_RATIO=2
# ALERT_SPEND_SPIKE_MIN_USD=1
# 单个账号费用上限（美元）。不设置则只在请求传入 spend_threshold_usd，或下面按账号覆盖时生效。
# ALERT_SPEND_THRESHOLD_USD=50
# 按 account_id 覆盖 min_tokens / spend_usd。必须是一行 JSON。
# ALERT_ACCOUNT_THRESHOLDS={"acme-prod":{"min_tokens":5000,"spend_usd":20}}
# 可选通知地址。不填则页面上的「推送」不会向外发送。请求需带 notify=true。
# LOW_USAGE_WEBHOOK_URL=https://hooks.example.com/token-rankings/low-usage
