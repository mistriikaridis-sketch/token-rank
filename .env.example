# Copy to .env and adjust. docker compose reads .env automatically if present.
TOKEN_RANKINGS_API_KEY=dev-token-rankings-change-me
SEED_ON_START=0

# Light RBAC: user API keys → role + account_id
# Prefer USERS_FILE (JSON array). USERS_JSON inline also works.
USERS_FILE=/app/fixtures/users.json
# USERS_JSON=[{"api_key":"demo-alice-key","role":"member","account_id":"acme-prod","name":"Alice"}]
# If 1, ranking GETs require a valid key (member/admin/service).
RANKINGS_REQUIRE_AUTH=0

# Database: unset = SQLite (demo). Production: Postgres.
# With overlay: docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
# DATABASE_URL=postgresql://token:token@postgres:5432/token_rankings

# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_MASTER_KEY=sk-your-master-key
# CURSOR_ADMIN_API_KEY=key_xxx
# WORKBUDDY_PROJECTS_DIR=/workbuddy/projects
# CLAUDE_PROJECTS_DIR=/claude/projects
# CLAUDE_ACCOUNT_ID=you@company.com
# CODEX_SESSIONS_DIR=/codex/sessions
# CODEX_ACCOUNT_ID=you@company.com
# CONTINUE_DATA_DIR=/continue/dev_data
# CONTINUE_ACCOUNT_ID=you@company.com

# Low-usage alerts webhook (optional). If unset, notify=1 skips POST.
# LOW_USAGE_WEBHOOK_URL=https://hooks.example.com/token-rankings/low-usage

